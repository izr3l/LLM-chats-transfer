{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "outDir": "./dist",
    "types": ["chrome", "node"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*"]
}
