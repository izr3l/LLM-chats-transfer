{
  "manifest_version": 3,
  "name": "LLM Chat Transfer",
  "version": "1.0.1",
  "description": "Transfer chat history between Claude, ChatGPT, Gemini, Manus, Qwen, Perplexity, and Grok.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://manus.im/*",
    "https://www.manus.im/*",
    "https://manus.com/*",
    "https://www.manus.com/*",
    "https://manus.ai/*",
    "https://www.manus.ai/*",
    "https://manus.computer/*",
    "https://www.manus.computer/*",
    "https://chat.qwen.ai/*",
    "https://qwen.ai/*",
    "https://qwenlm.ai/*",
    "https://www.perplexity.ai/*",
    "https://x.com/i/grok*",
    "https://api.groq.com/*",
    "https://api.openai.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.googleapis.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://manus.im/*",
        "https://www.manus.im/*",
        "https://manus.com/*",
        "https://www.manus.com/*",
        "https://manus.ai/*",
        "https://www.manus.ai/*",
        "https://manus.computer/*",
        "https://www.manus.computer/*",
        "https://chat.qwen.ai/*",
        "https://qwen.ai/*",
        "https://qwenlm.ai/*",
        "https://www.perplexity.ai/*",
        "https://x.com/i/grok*"
      ],
      "js": ["content-toolbar.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}